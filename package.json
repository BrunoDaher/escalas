{
  "name": "appescalas",
  "version": "1.0.0",
  "description": "App de escalas musicais feito com Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "author": "Bruno Coelho",
  "license": "MIT",
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^24.6.0"
  },
"build": {
  "appId": "com.brunocoelho.appescalas",
  "productName": "AppEscalas",
  "mac": {
    "category": "public.app-category.music",
    "target": [
      "dmg"
    ],
    "hardenedRuntime": true,
    "entitlements": "entitlements.mac.plist",
    "entitlementsInherit": "entitlements.mac.plist",
    "gatekeeperAssess": false
  },
  "asar": true
}
}
